    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#05050a"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#e8e0d0"
      },
      {
        "type": "color",
        "id": "color_accent_gold",
        "label": "Accent Gold",
        "default": "#c9913a"
      },
      {
        "type": "color",
        "id": "color_accent_crimson",
        "label": "Accent Crimson",
        "default": "#c0102a"
      },
      {
        "type": "color",
        "id": "color_accent_teal",
        "label": "Accent Teal",
        "default": "#2ab8c0"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "cinzel_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "cormorant_garamond_n3"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Cart Drawer" },
          { "value": "page",   "label": "Cart Page" },
          { "value": "popup",  "label": "Popup" }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal_on_scroll",
        "label": "Reveal elements on scroll",
        "default": true
      },
      {
        "type": "select",
        "id": "animations_hover_elements",
        "label": "Hover animations",
        "options": [
          { "value": "none",    "label": "None" },
          { "value": "lift",    "label": "Lift" },
          { "value": "scale",   "label": "Scale" }
        ],
        "default": "lift"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
