        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter / X"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      }
    ]
