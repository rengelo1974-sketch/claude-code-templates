{% comment %}
  ArSs Dark Deco — Footer Section
{% endcomment %}

<footer class="site-footer" role="contentinfo">

  <!-- Art Deco top border ornament -->
  <div style="
    position:absolute;
    top:0;left:50%;
    transform:translateX(-50%);
    display:flex;
    align-items:center;
    gap:var(--space-sm);
    width:min(60rem,80%);
  " aria-hidden="true">
    <div style="flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--c-gold-dim));"></div>
    <div style="width:0.6rem;height:0.6rem;background:var(--c-gold);transform:rotate(45deg);opacity:0.5;"></div>
    <div style="flex:1;height:1px;background:linear-gradient(90deg,var(--c-gold-dim),transparent);"></div>
  </div>

  <div class="container">
    <div class="footer-grid">

      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="site-logo" data-text="{{ shop.name }}">
          Ar<span>S</span>s
        </a>

        {%- if section.settings.tagline != blank -%}
          <p style="margin-top:var(--space-md);">{{ section.settings.tagline }}</p>
        {%- else -%}
          <p style="margin-top:var(--space-md);">
            Dark Deco Fashion.<br>
            Born in the shadows.<br>
            Worn in the night.
          </p>
        {%- endif -%}

        <!-- Social Links -->
        <div class="social-links" style="margin-top:var(--space-lg);">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="social-link" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="social-link" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.47a8.16 8.16 0 0 0 4.77 1.52V7.54a4.85 4.85 0 0 1-1-.85z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
            <a href="{{ section.settings.twitter_url }}" class="social-link" target="_blank" rel="noopener" aria-label="Twitter/X">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link Columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col">
            <h4>{{ block.settings.heading }}</h4>
            <nav class="footer-links">
              {%- for link in linklists[block.settings.menu].links -%}
                <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <!-- Footer Bottom Bar -->
    <div class="footer-bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.
        {%- if section.settings.copyright_text != blank -%}
          &nbsp;&nbsp;{{ section.settings.copyright_text }}
        {%- endif -%}
      </p>

      <div style="display:flex;gap:var(--space-lg);align-items:center;">
        {%- for link in linklists['footer'].links -%}
          <a href="{{ link.url }}" class="footer-link" style="font-size:1.1rem;">
            {{ link.title }}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Additional copyright text"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter/X URL"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Navigation"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "Shop",
          "menu": "main-menu"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "Info",
          "menu": "footer"
        }
      }
    ]
  }
}
{% endschema %}
