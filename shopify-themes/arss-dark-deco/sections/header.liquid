{% comment %}
  ArSs Dark Deco — Header / Navigation
{% endcomment %}

<header class="site-header" role="banner">
  <div class="header-inner">

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-toggle header-icon" aria-expanded="false" aria-label="Open menu">
      <svg width="20" height="14" viewBox="0 0 20 14" fill="currentColor">
        <rect width="20" height="1.5" y="0"/>
        <rect width="14" height="1.5" y="6"/>
        <rect width="20" height="1.5" y="12"/>
      </svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="site-logo" data-text="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 200 }}"
             alt="{{ shop.name }}"
             width="{{ settings.logo.width }}"
             height="{{ settings.logo.height }}"
             loading="eager">
      {%- else -%}
        Ar<span>S</span>s
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links" role="navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links != blank -%}
          <div class="nav-item nav-item--dropdown">
            <a href="{{ link.url }}" class="nav-link" aria-haspopup="true">
              {{ link.title }}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="currentColor" style="margin-left:4px;">
                <path d="M0 0 L5 6 L10 0"/>
              </svg>
            </a>
            <div class="nav-dropdown">
              {%- for child_link in link.links -%}
                <a href="{{ child_link.url }}" class="nav-dropdown__link">{{ child_link.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}"
             class="nav-link{% if link.active %} nav-link--active{% endif %}">
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Search -->
      <a href="{{ routes.search_url }}" class="header-icon" aria-label="{{ 'general.search.search' | t }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7.5" cy="7.5" r="6"/>
          <path d="M12 12 L16.5 16.5"/>
        </svg>
      </a>

      <!-- Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
           class="header-icon"
           aria-label="{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.login_page.title' | t }}{% endif %}">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="6" r="4"/>
            <path d="M1.5 16.5a7.5 7.5 0 0115 0"/>
          </svg>
        </a>
      {%- endif -%}

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" class="header-icon"
         style="position:relative;"
         data-cart-open
         aria-label="{{ 'sections.cart.title' | t }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1.5 1.5h2.25L5.4 11.25a1.5 1.5 0 001.5 1.5h7.35a1.5 1.5 0 001.485-1.275L16.5 5.25H4.5"/>
          <circle cx="7.5" cy="15.75" r="1.25" fill="currentColor" stroke="none"/>
          <circle cx="13.5" cy="15.75" r="1.25" fill="currentColor" stroke="none"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <button class="mobile-menu__close" data-mobile-close aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <path d="M1 1 L19 19 M19 1 L1 19" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    <nav class="mobile-nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"
           class="mobile-nav__link{% if link.active %} active{% endif %}">
          {{ link.title }}
        </a>
        {%- if link.links != blank -%}
          {%- for child_link in link.links -%}
            <a href="{{ child_link.url }}" class="mobile-nav__link mobile-nav__link--child">
              {{ child_link.title }}
            </a>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="mobile-menu__footer">
      <a href="{{ routes.search_url }}" class="mobile-menu__action">Search</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
           class="mobile-menu__action">Account</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  /* ─── Mobile Menu ─────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: var(--c-void);
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-out);
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .mobile-menu.open {
    transform: translateX(0);
    pointer-events: auto;
  }

  .mobile-menu__inner {
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }

  .mobile-menu__close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    color: var(--c-text-muted);
    cursor: pointer;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--t-base);
  }

  .mobile-menu__close:hover { color: var(--c-gold); }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--space-xl);
    flex: 1;
  }

  .mobile-nav__link {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--c-border-dim);
    transition: color var(--t-base), padding-left var(--t-base);
  }

  .mobile-nav__link:hover,
  .mobile-nav__link.active { color: var(--c-gold); padding-left: var(--space-md); }

  .mobile-nav__link--child {
    font-size: 1.8rem;
    padding-left: var(--space-md);
    border-bottom: none;
    color: var(--c-text-dim);
  }

  .mobile-menu__footer {
    display: flex;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
  }

  .mobile-menu__action {
    font-family: var(--font-ui);
    font-size: 1.2rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--c-text-dim);
    transition: color var(--t-base);
  }

  .mobile-menu__action:hover { color: var(--c-gold); }

  /* ─── Dropdown ─────────────────────────────────────────── */
  .nav-item--dropdown { position: relative; }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + var(--space-sm));
    left: 50%;
    transform: translateX(-50%) translateY(1rem);
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    min-width: 18rem;
    padding: var(--space-sm) 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-base), transform var(--t-base);
    clip-path: polygon(0.6rem 0, 100% 0, calc(100% - 0.6rem) 100%, 0 100%);
  }

  .nav-item--dropdown:hover .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown__link {
    display: block;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-ui);
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    transition: color var(--t-fast), padding-left var(--t-fast);
  }

  .nav-dropdown__link:hover {
    color: var(--c-gold);
    padding-left: calc(var(--space-lg) + 0.4rem);
  }

  @media (min-width: 769px) {
    .mobile-menu-toggle { display: none; }
  }

  @media (max-width: 768px) {
    .mobile-menu { display: flex; }
    .site-header .nav-links { display: none; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search icon"
    }
  ]
}
{% endschema %}
