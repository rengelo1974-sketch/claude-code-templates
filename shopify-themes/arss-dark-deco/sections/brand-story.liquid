{% comment %}
  ArSs Dark Deco — Brand Story / About Section
{% endcomment %}

<section class="section brand-story" id="brand-story">

  <!-- Subtle background pattern -->
  <div class="deco-bg-pattern"></div>

  <!-- Side decorative elements -->
  <div class="deco-fan" style="top:-4rem;left:-4rem;"></div>
  <div class="deco-fan" style="bottom:-4rem;right:-4rem;transform:rotate(180deg);"></div>

  <div class="container">
    <div class="brand-story__grid">

      <!-- Visual -->
      <div class="brand-story__visual reveal-left">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: 'ArSs Brand' }}"
            loading="lazy"
          >
        {%- else -%}
          <!-- Placeholder: Art Deco illustrated scene -->
          <div class="brand-story__placeholder" aria-hidden="true">
            <svg viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg"
                 style="width:100%;height:100%;background:var(--c-deep);">
              <!-- Stylized Art Deco silhouette scene -->
              <defs>
                <radialGradient id="bg-glow" cx="50%" cy="30%" r="50%">
                  <stop offset="0%" stop-color="#3d0a0a" stop-opacity="0.8"/>
                  <stop offset="100%" stop-color="#05050a" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="400" height="500" fill="#050510"/>
              <circle cx="200" cy="120" r="80" fill="url(#bg-glow)"/>
              <!-- Buildings silhouette -->
              <rect x="0"   y="200" width="60"  height="300" fill="#08080f"/>
              <rect x="5"   y="180" width="50"  height="25"  fill="#08080f"/>
              <rect x="10"  y="160" width="40"  height="25"  fill="#08080f"/>
              <rect x="60"  y="150" width="80"  height="350" fill="#0a0a15"/>
              <rect x="68"  y="130" width="64"  height="25"  fill="#0a0a15"/>
              <rect x="76"  y="110" width="48"  height="25"  fill="#0a0a15"/>
              <polygon points="100,50 110,50 115,80 120,80 130,110 140,110 150,500 50,500" fill="#060610"/>
              <rect x="260" y="180" width="70"  height="320" fill="#09090e"/>
              <rect x="265" y="160" width="60"  height="25"  fill="#09090e"/>
              <rect x="270" y="140" width="50"  height="25"  fill="#09090e"/>
              <rect x="330" y="220" width="70"  height="280" fill="#07070d"/>
              <!-- Windows -->
              <g fill="rgba(201,145,58,0.35)">
                <rect x="68" y="160" width="5" height="3"/>
                <rect x="80" y="160" width="5" height="3"/>
                <rect x="92" y="160" width="5" height="3"/>
                <rect x="68" y="172" width="5" height="3"/>
                <rect x="80" y="172" width="5" height="3"/>
                <rect x="68" y="184" width="5" height="3"/>
                <rect x="92" y="172" width="5" height="3"/>
                <rect x="265" y="180" width="5" height="3"/>
                <rect x="278" y="180" width="5" height="3"/>
                <rect x="290" y="180" width="5" height="3"/>
                <rect x="265" y="195" width="5" height="3"/>
                <rect x="278" y="195" width="5" height="3"/>
              </g>
              <g fill="rgba(42,184,192,0.25)">
                <rect x="8" y="200" width="4" height="2"/>
                <rect x="16" y="200" width="4" height="2"/>
                <rect x="8" y="210" width="4" height="2"/>
                <rect x="16" y="210" width="4" height="2"/>
                <rect x="8" y="220" width="4" height="2"/>
              </g>
              <!-- Ground fog -->
              <rect x="0" y="380" width="400" height="120" fill="url(#bg-glow)" opacity="0.3"/>
              <!-- Foreground figure (silhouette) -->
              <ellipse cx="200" cy="490" rx="30" ry="5" fill="rgba(0,0,0,0.6)"/>
              <rect x="193" y="380" width="14" height="110" fill="#020205"/>
              <ellipse cx="200" cy="370" rx="20" ry="25" fill="#020205"/>
              <rect x="185" y="380" width="30" height="5"  fill="#020205"/>
              <!-- Hat brim -->
              <ellipse cx="200" cy="355" rx="30" ry="8" fill="#020205"/>
              <rect x="188" y="320" width="24" height="40" fill="#030308"/>
              <!-- Neon text glow -->
              <text x="200" y="300" text-anchor="middle"
                    font-family="'Cinzel Decorative',serif"
                    font-size="36" font-weight="900"
                    fill="none"
                    stroke="rgba(201,145,58,0.3)"
                    stroke-width="0.5"
                    letter-spacing="8">ARSS</text>
              <text x="200" y="300" text-anchor="middle"
                    font-family="'Cinzel Decorative',serif"
                    font-size="36" font-weight="900"
                    fill="rgba(201,145,58,0.08)"
                    letter-spacing="8">ARSS</text>
            </svg>
          </div>
        {%- endif -%}

        <!-- Deco frame accent lines -->
        <div style="
          position:absolute;
          top:var(--space-lg);right:calc(-1 * var(--space-md));
          width:1px;height:40%;
          background:linear-gradient(180deg,var(--c-gold-dim),transparent);
        "></div>
        <div style="
          position:absolute;
          bottom:var(--space-lg);left:calc(-1 * var(--space-md));
          width:1px;height:40%;
          background:linear-gradient(0deg,var(--c-crimson-dim),transparent);
        "></div>
      </div>

      <!-- Text Content -->
      <div class="brand-story__text reveal-right">
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'Our Manifesto' }}</p>

        <h2>{{ section.settings.heading | default: 'Shadows Made Tangible' }}</h2>

        <div class="deco-divider">
          <div class="deco-divider-center"></div>
        </div>

        {%- if section.settings.text != blank -%}
          <div class="brand-story__body">{{ section.settings.text }}</div>
        {%- else -%}
          <p>ArSs is born from the tension between darkness and elegance — where the angular geometry of Art Deco meets the shadow-drenched atmosphere of noir.</p>
          <p>Each piece is a city at midnight. A neon sign reflected in rain. A silhouette against a crimson sky. We don't make clothing — we craft atmosphere.</p>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: routes.root_url }}" class="btn btn-secondary" style="margin-top:var(--space-lg);">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}

        <!-- Stats / attributes -->
        {%- if section.settings.show_stats -%}
          <div class="brand-stats">
            <div class="brand-stat">
              <span class="brand-stat__number">{{ section.settings.stat_1_number | default: '100%' }}</span>
              <span class="brand-stat__label">{{ section.settings.stat_1_label | default: 'Limited Runs' }}</span>
            </div>
            <div class="brand-stat">
              <span class="brand-stat__number">{{ section.settings.stat_2_number | default: '48h' }}</span>
              <span class="brand-stat__label">{{ section.settings.stat_2_label | default: 'Production' }}</span>
            </div>
            <div class="brand-stat">
              <span class="brand-stat__number">{{ section.settings.stat_3_number | default: '∞' }}</span>
              <span class="brand-stat__label">{{ section.settings.stat_3_label | default: 'Aesthetic' }}</span>
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  .brand-story__body p {
    font-family: var(--font-body);
    font-size: 1.8rem;
    font-weight: 300;
    color: var(--c-text-muted);
    line-height: 1.9;
    margin-bottom: var(--space-md);
  }

  .brand-stats {
    display: flex;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--c-border-dim);
  }

  .brand-stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .brand-stat__number {
    font-family: var(--font-heading);
    font-size: 3.2rem;
    font-weight: 600;
    color: var(--c-gold);
    text-shadow: var(--glow-gold);
    letter-spacing: 0.05em;
  }

  .brand-stat__label {
    font-family: var(--font-ui);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-text-dim);
  }

  .brand-story__placeholder {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .brand-stats { gap: var(--space-lg); }
    .brand-stat__number { font-size: 2.4rem; }
  }
</style>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Manifesto"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shadows Made Tangible"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show stats",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "Limited Runs"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 number",
      "default": "48h"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "Production"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 number",
      "default": "∞"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 label",
      "default": "Aesthetic"
    }
  ],
  "presets": [
    {
      "name": "Brand Story",
      "category": "Image"
    }
  ]
}
{% endschema %}
